# Copy to .env (git-ignored) or export these in your shell / pass them to Docker.
# Sealpost reads secrets from the environment and never stores them in sealpost.config.json.

# Admin key for Studio and the REST API. Required when Studio binds a non-loopback address.
#   openssl rand -hex 24
SEALPOST_API_KEY=

# Password for your SMTP relay; name this variable in a mailbox's "passwordEnv".
SMTP_PASSWORD=

# Secret for signing outbound webhooks; name it in a webhook's "secretEnv".
SEALPOST_WHSEC=

# Shared token that authenticates relay feedback at /hooks/relay/<ses|sendgrid|postmark|mailgun>?token=…
SEALPOST_WEBHOOK_SECRET=

# Only with "storage": { "type": "postgres", "urlEnv": "DATABASE_URL" }
DATABASE_URL=
