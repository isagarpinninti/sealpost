{
  "name": "@sealpost/react",
  "version": "0.1.0",
  "description": "React components for building and sending email: a visual email editor, a deliverability gate, a domain and mailbox vault and an SMTP transcript inspector. Ships a precompiled, scoped stylesheet.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Sagar Pinninti",
    "url": "https://github.com/isagarpinninti"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isagarpinninti/sealpost.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/isagarpinninti/sealpost#readme",
  "bugs": {
    "url": "https://github.com/isagarpinninti/sealpost/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "email",
    "email-editor",
    "visual-editor",
    "dkim",
    "smtp",
    "sealpost"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sealpost/core": "^0.1.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "lucide-react": ">=0.400.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "^1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
